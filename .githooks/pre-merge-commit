#!/bin/sh
# 보호 브랜치에서 로컬 머지로 코드를 들이는 것을 막는다.
# 작업 브랜치의 머지(main 따라잡기)는 통합이지 저작이 아니므로 통과시킨다 — 동료의 claim·저널이 딸려 들어오는 게 정상이다.
root="$(git rev-parse --show-toplevel)" || exit 0
if [ -e "$root/.petra/manifest.json" ]; then
  export CLAUDE_PROJECT_DIR="$root" RUNTIME_ROOT="$root/.petra/runtime"
  . "$RUNTIME_ROOT/harness/hooks/lib.sh"
  is_protected_branch "$(current_branch)" && exec sh "$root/.petra/bin/petra" precommit
  exit 0
fi
[ -f "$root/scripts/collab.sh" ] || exit 0
br="$(git symbolic-ref --short -q HEAD 2>/dev/null)" || exit 0
for pb in $(sed -n 's/^PROTECTED_BRANCHES="\(.*\)"/\1/p' "$root/harness/config.sh" 2>/dev/null); do
  [ "$br" = "$pb" ] && exec sh "$root/scripts/collab.sh" precommit
done
exit 0
