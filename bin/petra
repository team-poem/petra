#!/bin/sh
# 소비 패키지의 진입점. 실행 코드 위치와 프로젝트 위치를 분리한다.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ -f "$HERE/../manifest.json" ]; then
  ROOT=$(CDPATH= cd -- "$HERE/../.." && pwd -P)
  RUNTIME_ROOT="$ROOT/.petra/runtime"
else
  ROOT=$(CDPATH= cd -- "$HERE/.." && pwd -P)
  RUNTIME_ROOT="$ROOT"
fi
# 다른 리포에서 호출해도 설치된 프로젝트를 대상으로 삼는다.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_PREFIX
export PETRA_PROJECT_ROOT="$ROOT" CLAUDE_PROJECT_DIR="$ROOT" RUNTIME_ROOT
command=${1:-help}; [ $# -eq 0 ] || shift
case "$command" in
  update|rollback|migrate|recover)
    [ "$RUNTIME_ROOT" = "$ROOT" ] || { echo '수명주기 변경은 검토한 제작 리포의 bin/petra에서 실행하세요.' >&2; exit 1; }
    exec node "$ROOT/harness/lifecycle-petra.mjs" "$command" --source "$ROOT" "$@" ;;
  install)
    [ "$RUNTIME_ROOT" = "$ROOT" ] || { echo 'install/update는 검토한 제작 리포의 bin/petra에서 실행합니다.' >&2; exit 1; }
    exec node "$ROOT/harness/install-petra.mjs" --source "$ROOT" "$@" ;;
  pack)
    [ "$RUNTIME_ROOT" = "$ROOT" ] || { echo 'pack은 제작 리포에서만 사용합니다' >&2; exit 1; }
    exec sh "$ROOT/harness/package-petra.sh" "$@" ;;
  verify)
    exec sh "$RUNTIME_ROOT/harness/verify-petra.sh" "$ROOT" ;;
  onboard)
    [ "$RUNTIME_ROOT" != "$ROOT" ] || { echo '먼저 install로 대상 프로젝트에 PETRA를 연결하세요. 제작 리포 자체를 앱으로 초기화하지 않습니다.'; exit 0; }
    sh "$RUNTIME_ROOT/harness/verify-petra.sh" "$ROOT"
    echo '안녕하세요. PETRA 협업 하네스입니다.'
    echo '작업 선언은 목표를, 스냅샷은 편집 중인 파일을, 저널은 동료가 알아야 할 변경을 전합니다.'
    state=$(sh "$RUNTIME_ROOT/scripts/collab.sh" state)
    printf '%s\n' "$state"
    if printf '%s\n' "$state" | grep -qx state=ready; then
      echo '이미 합류했습니다. digest --fetch로 동료 상태를 읽고 작업을 시작하세요.'
    else
      echo '사용할 핸들을 확인해 join <핸들>을 실행하세요. 먼저 설명이 필요하면 .petra/README.md를 읽어주세요.'
      echo '자동 commit/push는 하지 않았고 앱 이름·README·Test 명령도 변경하지 않았습니다.'
    fi ;;
  join)
    [ $# -eq 1 ] && printf '%s' "$1" | LC_ALL=C grep -Eq '^[a-zA-Z0-9_][a-zA-Z0-9_-]*$' || { echo '사용법: petra join <핸들>' >&2; exit 1; }
    sh "$RUNTIME_ROOT/harness/verify-petra.sh" "$ROOT"
    if jq -e '.installation' "$ROOT/.petra/manifest.json" >/dev/null; then
      node "$RUNTIME_ROOT/harness/petra-files.mjs" join-check "$ROOT"
    else
      # staging pack의 기존 합류 동작을 유지하되 임의 hooksPath는 덮지 않는다.
      meta=$(git -C "$ROOT" rev-parse --absolute-git-dir)
      if [ ! -e "$meta/sobaya/connection.json" ]; then
        old=$(git -C "$ROOT" config core.hooksPath || true)
        case "$old" in ''|.githooks) ;; *) echo '기존 hooksPath가 있어 자동 변경하지 않습니다' >&2; exit 1 ;; esac
      fi
    fi
    . "$RUNTIME_ROOT/harness/sobaya/installed-lib.sh"
    si_setup_collab_hooks "$ROOT"
    scope=--local
    [ "$(git -C "$ROOT" config --bool extensions.worktreeConfig || true)" != true ] || scope=--worktree
    git -C "$ROOT" config "$scope" collab.me "$1"
    printf '안녕하세요, @%s. PETRA가 준비됐습니다. digest --fetch로 동료 작업부터 확인하세요.\n' "$1" ;;
  sobaya)
    [ "$RUNTIME_ROOT" != "$ROOT" ] || { echo '제작 리포는 sh harness/sobaya-installed.sh를 사용합니다' >&2; exit 1; }
    sh "$RUNTIME_ROOT/harness/verify-petra.sh" "$ROOT" >/dev/null
    exec sh "$RUNTIME_ROOT/harness/sobaya-installed.sh" "$@" ;;
  hook)
    [ $# -eq 1 ] || exit 1
    case "$1" in session-start|guard|post-edit|stop) exec sh "$RUNTIME_ROOT/harness/hooks/$1.sh" ;; *) exit 1 ;; esac ;;
  help)
    echo 'PETRA: onboard | join <핸들> | verify | digest --fetch | share | pulse | checkpoint --message TEXT -- FILE... | check | pr-body'
    echo '개발 하네스: sobaya attach|sync|bump|check --install-root <개인 저장소> [옵션]'
    echo '제작 리포: pack <새 빈 경로> | install --target <Git 루트> --dry-run | --apply --expect-plan <id>'
    echo '제작 리포: update|rollback|migrate --target ROOT --dry-run | --apply --expect-plan ID (migrate에는 --legacy-source 필요)'
    echo '중단 복구: recover --target ROOT --dry-run | --apply' ;;
  state|digest|pulse|share|checkpoint|guard|check|run|worktree|prune|wip|pr-body|precommit|prepush)
    exec sh "$RUNTIME_ROOT/scripts/collab.sh" "$command" "$@" ;;
  *) echo "알 수 없는 PETRA 명령: $command" >&2; exit 1 ;;
esac
